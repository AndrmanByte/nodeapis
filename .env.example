# NodeAPIs 环境变量配置
# 复制此文件为 .env.local 并填入你的实际值

# ===========================================
# Supabase 配置 (必需)
# ===========================================
# 从 Supabase Dashboard -> Settings -> API 获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ===========================================
# OAuth 配置 (在 Supabase Dashboard 配置)
# ===========================================
# Google OAuth:
# 1. 前往 Google Cloud Console -> APIs & Services -> Credentials
# 2. 创建 OAuth 2.0 Client ID
# 3. 添加授权重定向 URI: https://your-project.supabase.co/auth/v1/callback
# 4. 在 Supabase Dashboard -> Authentication -> Providers -> Google 中配置

# Discord OAuth:
# 1. 前往 Discord Developer Portal -> Applications
# 2. 创建应用并获取 Client ID 和 Client Secret
# 3. 添加 Redirect URI: https://your-project.supabase.co/auth/v1/callback
# 4. 在 Supabase Dashboard -> Authentication -> Providers -> Discord 中配置

# ===========================================
# 本地 PostgreSQL 配置 (可选，使用本地数据库时)
# ===========================================
POSTGRES_USER=nodeapis
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=nodeapis

# ===========================================
# 应用配置
# ===========================================
NODE_ENV=production

# ===========================================
# Umami 分析配置
# ===========================================
# 如果使用 Umami Cloud，只需设置 WEBSITE_ID
# 如果自托管 Umami，需要同时设置 URL 和 WEBSITE_ID

# 你的网站 ID (在 Umami 后台创建网站后获取)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id

# Umami 脚本地址 (自托管时填写，使用 Umami Cloud 可留空)
# 默认: https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_URL=https://your-umami-domain.com/script.js

# Umami API 配置 (用于后台统计面板)
# API 基础地址 (默认: https://cloud.umami.is/api)
UMAMI_API_URL=https://your-umami-domain.com/api

# API Token (在 Umami 设置 -> API Keys 中创建)
UMAMI_API_TOKEN=your-api-token

# 共享链接 (可选，用于嵌入完整仪表板)
# 在 Umami 网站设置 -> Share URL 中开启
NEXT_PUBLIC_UMAMI_SHARE_URL=https://your-umami-domain.com/share/xxxxx

# ===========================================
# DeepSeek AI 配置 (用于描述优化)
# ===========================================
# 从 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=your-deepseek-api-key
